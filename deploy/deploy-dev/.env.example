# Copia a deploy/deploy-dev/.env (no lo subas al repositorio). Valores solo para tu equipo.
# Dentro de Docker la base se llama "db"; desde tu equipo es 127.0.0.1:5433 (ver .env.example de la raíz).
DATABASE_URL=postgresql://app:app@db:5432/app
SECRET_KEY=solo-para-desarrollo
SESSION_COOKIE_SECURE=false
